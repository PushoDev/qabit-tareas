{
  "name": "qabit-tareas",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "test": "npm test -w server --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
