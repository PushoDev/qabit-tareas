# Plantilla: la imagen de nginx sustituye ${NGINX_LOCAL_RESOLVERS} al arrancar (ver compose.yaml).
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Volver a resolver el nombre «api» cada 2 segundos. Sin esto, nginx se queda con la IP que tenía
    # al arrancar y, si el contenedor de la API se reinicia con otra IP, responde 502 hasta reiniciar la web.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=2s ipv6=off;
    set $api_upstream http://api:3001;

    # La web llama a /api/...: se reenvía al contenedor de la API (mismo origen, sin CORS).
    # Con una variable en proxy_pass, la ruta original (/api/...) se conserva tal cual.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_connect_timeout 2s;   # si la IP es vieja, fallar rápido y que el siguiente intento ya resuelva la nueva
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Archivos estáticos; cualquier otra ruta devuelve index.html
    location / {
        try_files $uri /index.html;
    }
}
